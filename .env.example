# Copia este archivo a ".env" y reemplaza con tus datos reales.
# Esta es la cadena de conexion que te da tu proveedor de PostgreSQL en la nube
# (Neon, Supabase, Railway, ElephantSQL, etc). Debe incluir sslmode=require.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db?sslmode=require

# Puerto local (Render asigna el suyo propio automaticamente en produccion)
PORT=3001
